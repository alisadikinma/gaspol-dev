#!/usr/bin/env bash
# regression-gate — does this branch fix a bug, and if so did it leave a
# regression test? Prose could not enforce prose: gaspol-debug Phase 4 step 1
# used to say "Create a failing test case (if possible)", with nothing
# checking whether it was possible or whether one was written. This is the
# machine that replaces the escape hatch (IDS-14 Phase A1/A2).
#
# Usage:  regression-gate <BASE> [ledger-path]
#         regression-gate --self-test
#
# Contract:
#   $1        BASE ref — commit subjects over BASE..HEAD are read to decide
#             whether this is a bug-fixing branch at all.
#   $2        optional ledger path. Omitted -> the same fallback order
#             gaspol-execute already uses: the single
#             .gaspol/progress/PROGRESS-*.md if EXACTLY one exists, else
#             .gaspol/progress.md, else unresolved (treated as UNKNOWN — a
#             caller that already knows its ticket should pass the path
#             explicitly rather than rely on this fallback).
#   stdout    one line: "regression-gate: <verdict>". Printed on every exit
#             path, including the non-zero ones, so a caller can capture it
#             unconditionally and record it in a report or ledger line.
#   exit 0    satisfied — a fix commit exists, and the ledger's LAST
#             regression-test: line is either the written form, or an N/A /
#             "not run" form that carries an actual reason after the dash.
#   exit 1    BLOCKING — a fix commit exists, and either no regression-test:
#             line is present at all, or the only one present is a bare
#             "N/A" / "not run" with no reason — which is (if possible)
#             wearing a new label, not a decision with a name on it.
#   exit 3    UNKNOWN — a fix commit exists, but the ledger could not be
#             resolved (missing, or more than one PROGRESS-*.md and no
#             explicit path) or could not be read. STOP and ask; never
#             treat this as satisfied or as not-applicable.
#   exit 4    not applicable — no fix commits in BASE..HEAD. NEVER counted
#             as a pass, the same reason marketplace-manifest's exit 4 is
#             not: a gate that was not asked a question did not answer it.
#
# Fix-commit detection reuses the EXACT keyword set
# skills/gaspol-review/git-history-reviewer.md already uses for the same
# purpose (fix / revert / bug / regression / hotfix), so the two cannot
# disagree about what counts as a bug fix. Matched as a whole word against
# POSIX ERE (no \b — not portable across GNU and BSD grep).
#
# Commit subjects and ledger content are only ever grepped and compared here,
# never executed or interpolated into a command — unlike detect-stack /
# detect-app-target / marketplace-manifest, this script's stdout is a report
# line for a human or a ledger, not a command a caller runs.
set -euo pipefail

FIX_KEYWORDS='(^|[^A-Za-z])(fix|revert|bug|regression|hotfix)([^A-Za-z]|$)'

has_fix_commit() {
    # Captured into a variable, NOT piped straight into `grep -q`. Under
    # `set -o pipefail`, `grep -q` exiting the instant it finds a match can
    # SIGPIPE `git log` before it finishes writing -- pipefail then reports
    # the pipeline's exit status as git log's non-zero SIGPIPE code (its
    # own exit status counts even though it isn't the rightmost command to
    # run), not grep's successful match. That raced roughly one run in six
    # in practice: a real fix commit, reported as "not applicable" purely
    # from OS scheduling timing. Capturing first means grep reads a
    # finished string, and there is nothing left to race.
    local base="$1" subjects
    subjects="$(git log --format=%s "${base}..HEAD" 2>/dev/null || true)"
    printf '%s\n' "$subjects" | grep -qiE "$FIX_KEYWORDS"
}

# resolve_ledger GIVEN — prints the resolved ledger path on stdout, returns 1
# if none could be resolved (missing, or ambiguous with no explicit path).
resolve_ledger() {
    local given="${1:-}"
    if [ -n "$given" ]; then
        printf '%s\n' "$given"
        return 0
    fi
    local dir=".gaspol/progress"
    if [ -d "$dir" ]; then
        local matches=()
        shopt -s nullglob
        matches=("$dir"/PROGRESS-*.md)
        shopt -u nullglob
        if [ "${#matches[@]}" -eq 1 ]; then
            printf '%s\n' "${matches[0]}"
            return 0
        elif [ "${#matches[@]}" -gt 1 ]; then
            return 1
        fi
    fi
    if [ -f ".gaspol/progress.md" ]; then
        printf '%s\n' ".gaspol/progress.md"
        return 0
    fi
    return 1
}

# classify BODY — BODY is the regression-test: line with the prefix and
# leading whitespace already stripped. Prints the verdict word (satisfied /
# blocking) on stdout; the caller decides exit code and message.
classify() {
    local body="$1"
    case "$body" in
        N/A*|"not run"*)
            # N/A and "not run" both require an actual reason after the dash.
            # A bare label with nothing after it is (if possible) wearing a
            # new name — this is the whole point of Part A1: a decision with
            # a name on it, not a default nobody has to defend.
            local reason
            reason="$(printf '%s' "$body" | sed -E 's/^(N\/A|not run)[[:space:]]*[—-]+[[:space:]]*//')"
            if [ -z "$reason" ] || [ "$reason" = "$body" ]; then
                echo "blocking"
            else
                echo "satisfied"
            fi
            ;;
        *)
            echo "satisfied"
            ;;
    esac
}

# ---------------------------------------------------------------------------
self_test() {
    local tmp base rc out self
    self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' RETURN

    git -C "$tmp" init -q
    git -C "$tmp" config user.email test@example.com
    git -C "$tmp" config user.name test
    echo one > "$tmp/a.txt"
    git -C "$tmp" add a.txt
    git -C "$tmp" commit -q -m "chore: base"
    base="$(git -C "$tmp" rev-parse HEAD)"
    mkdir -p "$tmp/.gaspol/progress"

    # Case 1: no fix commits -> exit 4, never a pass.
    echo two >> "$tmp/a.txt"; git -C "$tmp" add a.txt; git -C "$tmp" commit -q -m "docs: tweak"
    rc=0; out="$(cd "$tmp" && "$self" "$base")" || rc=$?
    [ "$rc" = 4 ] || { echo "self-test: case1 (no fix commits) expected exit 4, got $rc ($out)" >&2; return 1; }

    # Case 2: fix commit, no ledger anywhere -> exit 3 UNKNOWN.
    echo three >> "$tmp/a.txt"; git -C "$tmp" add a.txt; git -C "$tmp" commit -q -m "fix: broken thing"
    rc=0; out="$(cd "$tmp" && "$self" "$base")" || rc=$?
    [ "$rc" = 3 ] || { echo "self-test: case2 (no ledger) expected exit 3, got $rc ($out)" >&2; return 1; }

    # Case 3: fix commit, ledger has no regression-test: line -> exit 1.
    printf '## Log\nsome other line — NEXT: x\n' > "$tmp/.gaspol/progress/PROGRESS-X.md"
    rc=0; out="$(cd "$tmp" && "$self" "$base")" || rc=$?
    [ "$rc" = 1 ] || { echo "self-test: case3 (no line) expected exit 1, got $rc ($out)" >&2; return 1; }

    # Case 4: written state -> exit 0.
    printf 'regression-test: tests/x.sh::case1 — RED at abc123, GREEN after fix\n' > "$tmp/.gaspol/progress/PROGRESS-X.md"
    rc=0; out="$(cd "$tmp" && "$self" "$base")" || rc=$?
    [ "$rc" = 0 ] || { echo "self-test: case4 (written) expected exit 0, got $rc ($out)" >&2; return 1; }

    # Case 5: N/A with a reason -> exit 0.
    printf 'regression-test: N/A — environment-only failure\n' > "$tmp/.gaspol/progress/PROGRESS-X.md"
    rc=0; out="$(cd "$tmp" && "$self" "$base")" || rc=$?
    [ "$rc" = 0 ] || { echo "self-test: case5 (N/A with reason) expected exit 0, got $rc ($out)" >&2; return 1; }

    # Case 6: bare N/A, no reason -> exit 1, a new silent default.
    printf 'regression-test: N/A\n' > "$tmp/.gaspol/progress/PROGRESS-X.md"
    rc=0; out="$(cd "$tmp" && "$self" "$base")" || rc=$?
    [ "$rc" = 1 ] || { echo "self-test: case6 (bare N/A) expected exit 1, got $rc ($out)" >&2; return 1; }

    # Case 7: ambiguous ledgers, no explicit path -> exit 3.
    printf 'regression-test: N/A — one\n' > "$tmp/.gaspol/progress/PROGRESS-X.md"
    printf 'regression-test: N/A — two\n' > "$tmp/.gaspol/progress/PROGRESS-Y.md"
    rc=0; out="$(cd "$tmp" && "$self" "$base")" || rc=$?
    [ "$rc" = 3 ] || { echo "self-test: case7 (ambiguous) expected exit 3, got $rc ($out)" >&2; return 1; }
    rm -f "$tmp/.gaspol/progress/PROGRESS-Y.md"

    # Case 8: explicit ledger-path argument overrides default resolution.
    mkdir -p "$tmp/elsewhere"
    printf 'regression-test: N/A — explicit path\n' > "$tmp/elsewhere/ledger.md"
    rc=0; out="$(cd "$tmp" && "$self" "$base" "elsewhere/ledger.md")" || rc=$?
    [ "$rc" = 0 ] || { echo "self-test: case8 (explicit path) expected exit 0, got $rc ($out)" >&2; return 1; }

    # Case 9: regression guard for a real bug found and fixed mid-ticket.
    # `git log ... | grep -qiE ...` under `set -o pipefail` raced: grep
    # exiting the instant it matched could SIGPIPE git log before it
    # finished writing, and pipefail then reported the pipeline's exit
    # status as git log's non-zero SIGPIPE code -- turning a REAL fix
    # commit into a false "not applicable" roughly one run in six. Fixed
    # by capturing git log's output into a variable before grep ever sees
    # it (has_fix_commit above). A single run cannot prove a race is gone;
    # run enough iterations that the original bug's failure rate would
    # almost certainly have shown up at least once.
    for _ in $(seq 1 25); do
        rc=0; out="$(cd "$tmp" && "$self" "$base")" || rc=$?
        [ "$rc" = 0 ] || { echo "self-test: case9 (pipefail/SIGPIPE race) got exit $rc on a real fix commit ($out)" >&2; return 1; }
    done

    echo "regression-gate: self-test OK"
}

main() {
    if [ "${1:-}" = "--self-test" ]; then self_test; exit $?; fi
    if [ $# -lt 1 ]; then
        echo "usage: regression-gate <BASE> [ledger-path]" >&2
        exit 1
    fi
    local base="$1"
    local given_ledger="${2:-}"

    if ! has_fix_commit "$base"; then
        echo "regression-gate: not applicable — no fix commits in ${base}..HEAD"
        exit 4
    fi

    local ledger
    if ! ledger="$(resolve_ledger "$given_ledger")"; then
        echo "regression-gate: UNKNOWN — could not resolve a ledger (checked .gaspol/progress/PROGRESS-*.md and .gaspol/progress.md; pass ledger-path explicitly if ambiguous)"
        exit 3
    fi
    if [ ! -r "$ledger" ]; then
        echo "regression-gate: UNKNOWN — ledger not readable: $ledger"
        exit 3
    fi

    local line body verdict
    line="$(grep -E '^regression-test:' "$ledger" 2>/dev/null | tail -n1 || true)"
    if [ -z "$line" ]; then
        echo "regression-gate: BLOCKING — fix commit(s) found in ${base}..HEAD, no regression-test: line in $ledger"
        exit 1
    fi

    body="${line#regression-test:}"
    body="$(printf '%s' "$body" | sed -E 's/^[[:space:]]+//')"
    verdict="$(classify "$body")"

    if [ "$verdict" = "satisfied" ]; then
        echo "regression-gate: satisfied — $body"
        exit 0
    else
        echo "regression-gate: BLOCKING — regression-test: line has no reason recorded ($body)"
        exit 1
    fi
}

main "$@"
